{
  "name": "taskunit",
  "version": "1.0.0",
  "description": "TASK UNITY — A cooperative-owned digital ecosystem for verified local skilled workers",
  "main": "server/index.ts",
  "scripts": {
    "server": "tsx server/index.ts",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "task-unity",
    "cooperative",
    "workers",
    "gig-platform"
  ],
  "author": "Task Unity Cooperative",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/uuid": "^11.0.0",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
